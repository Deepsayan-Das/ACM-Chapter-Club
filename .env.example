# Nodemailer / Email Configuration for Registration Form
# ----------------------------------------------------
# 1. EMAIL_USER: The email address sending the notifications (e.g. your Gmail)
EMAIL_USER=your-email@gmail.com

# 2. EMAIL_PASS: App password generated for your email account
# For Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_PASS=your-16-char-app-password

# 3. DESTINATION_EMAIL: The email address that should receive the submitted registrations
DESTINATION_EMAIL=acm-admin@example.com

# (Optional) Custom SMTP settings if not using standard Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

